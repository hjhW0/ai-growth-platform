# 生产环境配置（复制为 .env 后修改）

# 安全密钥（务必修改！）
SECRET_KEY=your-random-secret-key-here
JWT_SECRET_KEY=your-random-jwt-secret-here

# 数据库（默认 SQLite，切换 PostgreSQL 改这里）
DATABASE_URL=sqlite:////app/data/growth_platform.db
# DATABASE_URL=postgresql://user:pass@db:5432/growth_platform

# AI 配置
USE_LOCAL_AI=true
OLLAMA_URL=http://ollama:11434
MODEL_CHAT=qwen3:8b
MODEL_REASONING=deepseek-r1:8b
