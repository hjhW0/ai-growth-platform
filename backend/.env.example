# 应用配置
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# 数据库配置
DATABASE_URL=sqlite:///growth_platform.db

# AI 配置
# 使用本地 Ollama (true) 或 DeepSeek API (false)
USE_LOCAL_AI=false

# DeepSeek API 配置（USE_LOCAL_AI=false 时需要）
DEEPSEEK_API_KEY=your_api_key_here

# Ollama 配置（USE_LOCAL_AI=true 时需要）
# 默认地址: http://localhost:11434
# 默认模型: deepseek-r1:8b
